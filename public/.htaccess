Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase / 

    # kalau file/folder ADA, langsung lewat
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # semua request lain ke CI4
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>